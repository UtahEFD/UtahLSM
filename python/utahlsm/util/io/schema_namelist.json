{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "UtahLSM Namelist Validation Schema",
    "description": "Schema to validate the configuration namelist for the model.",
    "type": "object",
    "properties": {
        "general": {
            "type": "object",
            "properties": {
                "log_level": { "type": "string", "enum": ["info", "debug"] }
            },
            "required": ["log_level"]
        },
        "numerics": {
            "type": "object",
            "properties": {
                "diffusion_back_weight": { "type": "number",  "minimum": 0, "maximum": 1},
                "iterations": {
                    "type": "object",
                    "properties": {
                        "sfc_flux": { "type": "integer", "minimum": 1 },
                        "seb_bracket": { "type": "integer", "minimum": 1 },
                        "seb_root": { "type": "integer", "minimum": 1 },
                        "smb_flux": { "type": "integer", "minimum": 1 }
                    },
                    "required": ["sfc_flux", "seb_bracket", "seb_root", "smb_flux"]
                },
                "tolerances": {
                    "type": "object",
                    "properties": {
                        "sfc_flux": { "type": "number" },
                        "seb_root": { "type": "number" },
                        "smb_flux": { "type": "number" }
                    },
                    "required": ["sfc_flux", "seb_root", "smb_flux"]
                }
            },
            "required": ["diffusion_back_weight", "iterations", "tolerances"]
        },
        "time": {
            "type": "object",
            "properties": {
                "utc_start": { "type": "integer", "minimum": 0, "maximum": 86359 },
                "utc_year": { "type": "integer", "minimum": 1900, "maximum": 2100 },
                "julian_day": { "type": "integer", "minimum": 1, "maximum": 366 }
            },
            "required": ["utc_start", "utc_year", "julian_day"]
        },
        "grid": {
            "type": "object",
            "properties": {
                "nx": { "type": "integer", "minimum": 1 },
                "ny": { "type": "integer", "minimum": 1 },
                "nz": { "type": "integer", "minimum": 1 }
            },
            "required": ["nx", "ny", "nz"]
        },
        "surface": {
            "type": "object",
            "properties": {
                "z_o": { "type": "number", "minimum": 0 },
                "z_t": { "type": "number", "minimum": 0 },
                "z_m": { "type": "number", "minimum": 0 },
                "z_s": { "type": "number", "minimum": 0 },
                "albedo": { "type": "number", "minimum": 0, "maximum": 1 },
                "emissivity": { "type": "number", "minimum": 0, "maximum": 1 },
                "model": { "type": "integer", "enum": [1] }
                
            },
            "required": ["z_o", "z_t", "z_m", "z_s", "albedo", "emissivity", "model"]
        },
        "soil": {
            "type": "object",
            "properties": {
                "param": { "type": "integer", "enum": [1, 2, 3] },
                "model": { "type": "integer", "enum": [1, 2, 3] }
            },
            "required": ["param", "model"]
        },
        "radiation": {
            "type": "object",
            "properties": {
                "model": { "type": "integer", "enum": [0, 1] },
                "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
                "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
            },
            "required": ["model", "latitude", "longitude"]
        },
        "output": {
            "type": "object",
            "properties": {
                "save": { "type": "boolean"},
                "fields": {
                    "type": "array",
                    "items": { "type": "string" },
                    "minItems": 1
                }
            },
            "required": ["save", "fields"]
        }
    },
    "required": ["time", "grid", "surface", "soil", "radiation", "output"]
}
