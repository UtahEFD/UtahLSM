{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "UtahLSM Namelist Validation Schema",
    "description": "Schema to validate the configuration namelist for the model.",
    "type": "object",
    "properties": {
        "general": {
            "type": "object",
            "properties": {
                "log_level": { "type": "string", "enum": ["info", "debug"] }
            },
            "required": ["log_level"],
            "additionalProperties": false
        },
        "numerics": {
            "type": "object",
            "properties": {
                "heat_diffusion_back_weight": { "type": "number",  "minimum": 0, "maximum": 1},
                "iterations": {
                    "type": "object",
                    "properties": {
                        "sfc_flux": { "type": "integer", "minimum": 1 },
                        "seb_bracket": { "type": "integer", "minimum": 1 },
                        "seb_root": { "type": "integer", "minimum": 1 },
                        "smb_flux": { "type": "integer", "minimum": 1 },
                        "moisture_picard": { "type": "integer", "minimum": 1 },
                        "coupling": { "type": "integer", "minimum": 1 }
                    },
                    "required": ["sfc_flux", "seb_bracket", "seb_root", "smb_flux", "moisture_picard", "coupling"],
                    "additionalProperties": false
                },
                "tolerances": {
                    "type": "object",
                    "properties": {
                        "sfc_flux": { "type": "number", "exclusiveMinimum": 0 },
                        "seb_root": { "type": "number", "exclusiveMinimum": 0 },
                        "smb_flux": { "type": "number", "exclusiveMinimum": 0 },
                        "moisture_picard": { "type": "number", "exclusiveMinimum": 0 },
                        "moisture_bounds": { "type": "number", "exclusiveMinimum": 0 },
                        "coupling_temp": { "type": "number", "exclusiveMinimum": 0 },
                        "coupling_mois": { "type": "number", "exclusiveMinimum": 0 },
                        "smb_residual": { "type": "number", "exclusiveMinimum": 0 }
                    },
                    "required": ["sfc_flux", "seb_root", "smb_flux", "moisture_picard", "moisture_bounds", "coupling_temp", "coupling_mois"],
                    "additionalProperties": false
                }
            },
            "required": ["heat_diffusion_back_weight", "iterations", "tolerances"],
            "additionalProperties": false
        },
        "time": {
            "type": "object",
            "properties": {
                "utc_start": { "type": "integer", "minimum": 0, "maximum": 86359 },
                "utc_year": { "type": "integer", "minimum": 1900, "maximum": 2100 },
                "julian_day": { "type": "integer", "minimum": 1, "maximum": 366 }
            },
            "required": ["utc_start", "utc_year", "julian_day"],
            "additionalProperties": false
        },
        "grid": {
            "type": "object",
            "properties": {
                "nx": { "type": "integer", "minimum": 1 },
                "ny": { "type": "integer", "minimum": 1 },
                "nz": { "type": "integer", "minimum": 3 }
            },
            "required": ["nx", "ny", "nz"],
            "additionalProperties": false
        },
        "surface": {
            "type": "object",
            "properties": {
                "z_o": { "type": "number", "exclusiveMinimum": 0 },
                "z_t": { "type": "number", "exclusiveMinimum": 0 },
                "z_m": { "type": "number", "exclusiveMinimum": 0 },
                "z_s": { "type": "number", "exclusiveMinimum": 0 },
                "albedo": { "type": "number", "minimum": 0, "maximum": 1 },
                "emissivity": { "type": "number", "minimum": 0, "maximum": 1 },
                "model": { "type": "string", "enum": ["most"] },
                "psi_stable": { "type": "string", "enum": ["dyer-hicks", "beljaars-holtslag", "cheng-brutsaert"] },
                "zeta_max": { "type": "number", "exclusiveMinimum": 0 },
                "gustiness": { "type": "number", "minimum": 0 },
                "gustiness_stable_only": { "type": "boolean" }
                
            },
            "required": ["z_o", "z_t", "z_m", "z_s", "albedo", "emissivity", "model"],
            "additionalProperties": false
        },
        "soil": {
            "type": "object",
            "properties": {
                "properties": { "type": "string", "minLength": 1 },
                "model": { "type": "string", "enum": ["brooks-corey", "campbell", "van-genuchten"] },
                "thermal_conductivity_model": { "type": "string", "enum": ["mccumber-pielke", "johansen"] },
                "macropore_fraction": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
                "macropore_z_top": { "type": "number", "minimum": 0.0 },
                "macropore_z_bottom": { "type": "number", "minimum": 0.0 },
                "macropore_e_folding": { "type": "number", "exclusiveMinimum": 0.0 }
            },
            "required": ["properties", "model"],
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "macropore_fraction": { "exclusiveMinimum": 0.0 }
                        },
                        "required": ["macropore_fraction"]
                    },
                    "then": {
                        "required": ["macropore_z_top", "macropore_z_bottom"]
                    }
                }
            ],
            "additionalProperties": false
        },
        "radiation": {
            "type": "object",
            "properties": {
                "model": { "type": "string", "enum": ["forcing", "basic"] },
                "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
                "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
            },
            "required": ["model", "latitude", "longitude"],
            "additionalProperties": false
        },
        "canopy": {
            "type": "object",
            "properties": {
                "model": { "type": "string", "enum": ["none", "jarvis"] },
                "lai": { "oneOf": [{"type": "number", "minimum": 0}, {"type": "array", "items": {"type": "number", "minimum": 0}}] },
                "veg_fraction": { "oneOf": [{"type": "number", "minimum": 0, "maximum": 1}, {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1}}] },
                "rooting_depth": { "oneOf": [{"type": "number", "minimum": 0}, {"type": "array", "items": {"type": "number", "minimum": 0}}] },
                "beta": { "oneOf": [{"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}, {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}}] },
                "rs_min": { "oneOf": [{"type": "number", "exclusiveMinimum": 0}, {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0}}] },
                "rs_max": { "oneOf": [{"type": "number", "exclusiveMinimum": 0}, {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0}}] },
                "rg_half": { "oneOf": [{"type": "number", "exclusiveMinimum": 0}, {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0}}] },
                "vpd_coef": { "oneOf": [{"type": "number", "minimum": 0}, {"type": "array", "items": {"type": "number", "minimum": 0}}] },
                "t_opt": { "oneOf": [{"type": "number", "exclusiveMinimum": 0}, {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0}}] },
                "t_coef": { "oneOf": [{"type": "number", "minimum": 0}, {"type": "array", "items": {"type": "number", "minimum": 0}}] },
                "r_ground": { "oneOf": [{"type": "number", "minimum": 0}, {"type": "array", "items": {"type": "number", "minimum": 0}}] },
                "water_capacity_lai": { "oneOf": [{"type": "number", "minimum": 0}, {"type": "array", "items": {"type": "number", "minimum": 0}}] },
                "wet_cooling_max": { "oneOf": [{"type": "number", "minimum": 0}, {"type": "array", "items": {"type": "number", "minimum": 0}}] }
            },
            "required": ["model"],
            "additionalProperties": false
        },
        "output": {
            "type": "object",
            "properties": {
                "save": { "type": "boolean"},
                "fields": {
                    "type": "array",
                    "items": { "type": "string" },
                    "minItems": 1
                }
            },
            "required": ["save", "fields"],
            "additionalProperties": false
        }
    },
    "required": [
        "general",
        "numerics",
        "time",
        "grid",
        "surface",
        "soil",
        "radiation",
        "output"
    ],
    "additionalProperties": false
}
